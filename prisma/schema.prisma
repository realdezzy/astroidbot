generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("ASTROIDBOT_DATABASE_URL")
}

model User {
  id            Int      @id @default(autoincrement())
  telegramId    BigInt?  @unique
  email         String?  @unique
  passwordHash  String?
  username      String?
  emailVerified Boolean  @default(false)
  referralCode  String   @unique @default(uuid())
  referredBy    Int?
  referrer      User?    @relation("Referrals", fields: [referredBy], references: [id])
  referees      User[]   @relation("Referrals")
  points        Int      @default(0)
  isActive      Boolean  @default(true)
  isAdmin       Boolean  @default(false)
  createdAt     DateTime @default(now())

  wallets        Wallet[]
  tradeSettings  TradeSettings[]
  trades         Trade[]
  perpPositions  PerpPosition[]
  socialAccounts SocialAccount[]
}

model Wallet {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
  address      String
  chainFamily  String   @default("stacks")
  chain        String   @default("stacks:mainnet")
  name         String
  encryptedKey String
  balance      Float    @default(0)
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  trades        Trade[]
  perpPositions PerpPosition[]

  @@unique([chainFamily, address])
  @@index([userId, chain])
}

model TradeSettings {
  id                 Int      @id @default(autoincrement())
  userId             Int
  user               User     @relation(fields: [userId], references: [id])
  context            String   @default("personal")
  chain              String   @default("stacks:mainnet")
  slippageBps        Int      @default(100)
  maxPositionPct     Float    @default(25.0)
  dailyLossLimit     Float    @default(5.0)
  rebalanceThreshold Float    @default(2.0)
  useGasless         Boolean  @default(false)
  gaslessFeeToken    String   @default("USDC")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Trade {
  id               Int       @id @default(autoincrement())
  walletId         Int
  wallet           Wallet    @relation(fields: [walletId], references: [id])
  userId           Int
  user             User      @relation(fields: [userId], references: [id])
  direction        String
  tokenIn          String
  tokenOut         String
  amountIn         Float
  amountOut        Float
  feeAmount        Float     @default(0)
  feeBps           Int       @default(30)
  txId             String?
  status           String    @default("PENDING")
  errorMessage     String?
  isGasless        Boolean   @default(false)
  relayerFeeAmount Float?
  relayerFeeToken  String?
  amountInUsd      Float?
  amountOutUsd     Float?
  createdAt        DateTime  @default(now())
  confirmedAt      DateTime?

  @@index([userId, status, createdAt])
}

model MarketMakingGrid {
  id          Int      @id @default(autoincrement())
  userId      Int
  walletId    Int
  tokenPair   String
  midPrice    Float
  gridLevels  Int      @default(5)
  spreadBps   Int
  lastUpdated DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([walletId, tokenPair])
}

model AIRecommendation {
  id               Int      @id @default(autoincrement())
  userId           Int
  context          String
  inputHash        String
  modelProvider    String
  modelName        String
  promptTokens     Int
  completionTokens Int
  recommendation   Json
  actedUpon        Boolean  @default(false)
  createdAt        DateTime @default(now())
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model EmailToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  type      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, type])
  @@index([token])
}

model LimitOrder {
  id           Int       @id @default(autoincrement())
  userId       Int
  walletId     Int
  tokenIn      String
  tokenOut     String
  direction    String
  targetPrice  Float
  amountIn     Float
  status       String    @default("ACTIVE")
  forceAfter   DateTime?
  expiresAt    DateTime?
  failureCount Int       @default(0)
  createdAt    DateTime  @default(now())
  filledAt     DateTime?
  txId         String?

  @@index([userId, walletId])
  @@index([status])
}

model BlockedToken {
  id         Int      @id @default(autoincrement())
  userId     Int
  contractId String
  symbol     String
  createdAt  DateTime @default(now())

  @@unique([userId, contractId])
  @@index([userId])
}

model TradingStrategy {
  id           Int      @id @default(autoincrement())
  userId       Int
  agentId      Int?
  type         String
  config       Json
  state        Json     @default("{}")
  isActive     Boolean  @default(true)
  failureCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([agentId])
}

model TradeAgent {
  id           Int      @id @default(autoincrement())
  userId       Int
  name         String
  context      String   @default("custom")
  aiMode       String   @default("off")
  config       Json
  state        Json     @default("{}")
  model        String   @default("deepseek-v4-pro")
  isActive     Boolean  @default(true)
  failureCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model PerpPosition {
  id               Int      @id @default(autoincrement())
  userId           Int
  user             User     @relation(fields: [userId], references: [id])
  walletId         Int
  wallet           Wallet   @relation(fields: [walletId], references: [id])
  market           String
  direction        String // "LONG" | "SHORT"
  size             Float
  leverage         Float
  entryPrice       Float
  liquidationPrice Float
  margin           Float
  status           String // "OPEN" | "CLOSED" | "LIQUIDATED"
  txId             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([walletId])
  @@index([status])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String
  details   String
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  type      String // "INFO" | "WARNING" | "ERROR" | "SUCCESS"
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model Candle {
  id        Int      @id @default(autoincrement())
  // Network the token lives on. Without it the unique key collides across
  // chains: "USDC" on Base and "USDC" on Stacks are different assets at
  // different prices, and one would silently overwrite the other's candles.
  chainId   String   @default("stacks:mainnet")
  token     String
  timeframe String // "1m", "5m", "15m", "1h", "4h", "1d"
  timestamp DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float    @default(0)

  @@unique([chainId, token, timeframe, timestamp])
  @@index([chainId, token, timeframe, timestamp])
}

// Cross-chain token catalogue backing the public discovery pages.
//
// **Written only by the backend** (TokenDiscoveryService), from two sources:
// the registered DEX providers' token lists — what this deployment can
// actually route a trade through — and promotion of tokens the indexer has
// seen trade. The market columns here are a *cache* of IndexedToken, refreshed
// each discovery sync; IndexedToken is the source of truth and the only place
// the indexer writes.
//
// Keeping the cache rather than joining is deliberate. This table also holds
// the tokens of chains that have no indexer at all (Stacks, Solana), so a join
// would make discovery a union of two shapes; and sorting a page of twenty
// rows by volume should be one indexed scan, not a relation traversal.
model Token {
  id             Int       @id @default(autoincrement())
  chainId        String
  contractId     String // address, principal, or mint depending on the chain
  symbol         String
  name           String
  decimals       Int
  logoUrl        String?
  dexId          String?
  priceUsd       Float?
  priceChange5m  Float?
  priceChange1h  Float?
  priceChange6h  Float?
  priceChange24h Float?
  volume24h      Float?
  liquidityUsd   Float?
  marketCapUsd   Float?
  txnsBuys24h    Int?
  txnsSells24h   Int?
  pairCreatedAt  DateTime?
  isVerified     Boolean   @default(false)
  lastSyncedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([chainId, contractId])
  @@index([chainId, volume24h])
  @@index([symbol])
}

// ─── Internal market-data indexer ────────────────────────────────────────────
// Everything below backs MARKET_DATA_PROVIDER="internal": our own swap-event
// ingestion, so production doesn't depend on a third-party feed. DexScreener
// stays available as a development provider for exercising the same interface.
//
// **Ownership rule: every table below is written by the indexer process and by
// nothing else.** The backend reads them and never writes them. Token above is
// the mirror image — written only by the backend. Two processes writing one
// table is how you get a row whose columns disagree about which pass produced
// them, and no amount of care in either process fixes it from the outside.

// What the indexer observed about a token: its identity as read off-chain, and
// the metrics RollupService computes from that token's candles.
//
// Separate from Token because the two answer different questions and have
// different owners. Token is "what can this deployment offer a user" — curated,
// listable, backend-owned. IndexedToken is "what did we actually see trade" —
// every token with a pool, including the scams and the test deployments,
// written only here.
model IndexedToken {
  id             Int       @id @default(autoincrement())
  chainId        String
  contractId     String
  // Read from the contract at discovery time. A token whose symbol can't be
  // read is never catalogued — it would render as a blank row and is
  // overwhelmingly likely to be broken or hostile.
  symbol         String
  name           String
  decimals       Int
  dexId          String?
  // Metrics. Nullable throughout and deliberately so: null is "we don't know",
  // which is a different fact from zero and must sort to the other end of a
  // ranked table. Nothing here may be coalesced on write.
  priceUsd       Float?
  priceChange5m  Float?
  priceChange1h  Float?
  priceChange6h  Float?
  priceChange24h Float?
  volume24h      Float?
  liquidityUsd   Float?
  marketCapUsd   Float?
  txnsBuys24h    Int?
  txnsSells24h   Int?
  pairCreatedAt  DateTime?
  // Last time the rollup wrote metrics onto this row — not the last swap. Lets
  // the backend tell "no trades" from "the indexer stopped".
  lastRolledUpAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([chainId, contractId])
  // The discovery read path: rank a chain's tokens by volume.
  @@index([chainId, volume24h])
  // Cross-chain native-price anchoring looks a symbol up everywhere else.
  @@index([symbol])
}

// A liquidity pool we ingest swaps from. Discovered from the DEX factory's
// pool-creation events, never hand-listed — a chain's interesting pools are
// mostly ones that didn't exist when the code shipped.
model IndexedPool {
  id            Int       @id @default(autoincrement())
  chainId       String
  dexId         String // "uniswap-v3", "jupiter", "alex", …
  poolAddress   String
  // Contract ids, ordered as the pool itself orders them. Kept denormalized
  // rather than joined to Token: a pool is discovered before either side is
  // necessarily in the catalogue, and the indexer must not block on that.
  token0        String
  token1        String
  decimals0     Int
  decimals1     Int
  // Which side this pool is *about*. The quote side is the wrapped native or a
  // stable — the leg we can price — and the base is the token traded against
  // it. Stored rather than re-derived because the rollup must credit a pool's
  // price to exactly one token: crediting both made WETH inherit the inverse
  // of every memecoin it was paired with and report +469% in an hour.
  baseToken     String?
  quoteToken    String?
  feeTier       Int?
  // Block the pool was created in. Doubles as the backfill floor — there are
  // no swaps before it, so a fresh pool never triggers a full-chain rescan.
  createdBlock  BigInt?
  pairCreatedAt DateTime?

  // Latest observed state, refreshed by the rollup. Denormalized so the
  // discovery query never has to aggregate candles at read time.
  liquidityUsd Float?
  lastSwapAt   DateTime?
  lastPrice0   Float? // token0 priced in token1, from the last swap's sqrtPriceX96

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candles PoolCandle[]

  @@unique([chainId, poolAddress])
  @@index([chainId, dexId])
  // Rollups walk pools by the token they price.
  @@index([chainId, baseToken])
  @@index([chainId, token0])
  @@index([chainId, token1])
}

// Five-minute OHLCV buckets — the aggregation primitive every window is
// derived from. Raw swaps are deliberately *not* stored: a busy chain produces
// millions a day, and no question the UI asks needs finer resolution than the
// 5M column it renders. 288 rows/pool/day compacts ~4 orders of magnitude.
model PoolCandle {
  id          BigInt      @id @default(autoincrement())
  poolId      Int
  pool        IndexedPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  // Bucket start, floored to a 5-minute boundary in UTC.
  bucketStart DateTime

  open  Float
  high  Float
  low   Float
  close Float

  volumeUsd Float @default(0)
  buys      Int   @default(0)
  sells     Int   @default(0)

  @@unique([poolId, bucketStart])
  // Window rollups scan by time first, then narrow to pools.
  @@index([bucketStart])
  @@index([poolId, bucketStart])
}

// Per-chain ingestion cursor. One row per chain; the indexer resumes from
// lastBlock every tick, so a restart costs one block range rather than a
// rescan from genesis.
model IndexerCursor {
  chainId       String   @id
  // Last block whose logs are fully ingested. Held `confirmations` behind the
  // head so a reorg can't strand us ahead of canonical history.
  lastBlock     BigInt
  // Separate cursor: pool discovery scans the factory, swap ingestion scans
  // pools, and they advance at different rates (discovery can lag safely).
  lastPoolBlock BigInt?
  updatedAt     DateTime @updatedAt
}

model PoolStatsHistory {
  id                  Int      @id @default(autoincrement())
  token               String
  timestamp           DateTime @default(now())
  liquidityUsd        Float
  tvlUsd              Float
  volume24hUsd        Float
  holderConcentration Float    @default(0)
  netWhaleFlowUsd     Float    @default(0)

  @@index([token, timestamp])
}

// A linked social identity that may act on a user's behalf.
//
// Keyed on platformUserId, never the handle: handles are transferable and
// re-registrable, so trusting one would let anyone who acquires an abandoned
// @name move another user's funds.
model SocialAccount {
  id               Int       @id @default(autoincrement())
  userId           Int
  user             User      @relation(fields: [userId], references: [id])
  platform         String // "x" | "farcaster"
  platformUserId   String // immutable numeric/fid identifier
  handle           String // display only — never used for authorization
  verifiedAt       DateTime?
  // Caps enforced before execution and independently of RiskManager, so a
  // compromised social account cannot drain an account even if it passes
  // every trading-risk check.
  perTradeLimitUsd Float     @default(50)
  dailyLimitUsd    Float     @default(200)
  // Confirm-first by default: a reply with a signed link the user must open.
  // Auto-execute is strictly opt-in.
  autoExecute      Boolean   @default(false)
  enabled          Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  commands SocialCommand[]

  @@unique([platform, platformUserId])
  @@index([userId])
}

// One row per inbound post that addressed the bot.
//
// The unique key on [platform, postId] is the idempotency guard: streams
// redeliver, webhooks retry, and a restart can replay a backlog. Without it
// the same tweet could execute a trade more than once.
model SocialCommand {
  id               Int            @id @default(autoincrement())
  socialAccountId  Int?
  socialAccount    SocialAccount? @relation(fields: [socialAccountId], references: [id])
  platform         String
  postId           String
  authorId         String
  rawText          String
  parsedIntent     String? // JSON of the validated intent, or null if unparseable
  status           String         @default("RECEIVED") // RECEIVED|REJECTED|AWAITING_CONFIRMATION|EXECUTED|FAILED
  rejectionReason  String?
  tradeId          Int?
  confirmToken     String?        @unique
  confirmExpiresAt DateTime?
  createdAt        DateTime       @default(now())

  @@unique([platform, postId])
  @@index([socialAccountId, createdAt])
}
