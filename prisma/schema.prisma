generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("ASTROIDBOT_DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  telegramId   BigInt?   @unique
  email        String?   @unique
  passwordHash String?
  username     String?
  emailVerified Boolean  @default(false)
  referralCode String    @unique @default(uuid())
  referredBy   Int?
  referrer     User?     @relation("Referrals", fields: [referredBy], references: [id])
  referees     User[]    @relation("Referrals")
  points       Int       @default(0)
  isActive     Boolean   @default(true)
  isAdmin      Boolean   @default(false)
  createdAt    DateTime  @default(now())

  wallets       Wallet[]
  tradeSettings TradeSettings[]
  trades        Trade[]
  perpPositions PerpPosition[]
  socialAccounts SocialAccount[]
}

model Wallet {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
  address      String
  chainFamily  String   @default("stacks")
  chain        String   @default("stacks:mainnet")
  name         String
  encryptedKey String
  balance      Float    @default(0)
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  trades        Trade[]
  perpPositions PerpPosition[]

  @@unique([chainFamily, address])
  @@index([userId, chain])
}


model TradeSettings {
  id                 Int      @id @default(autoincrement())
  userId             Int
  user               User     @relation(fields: [userId], references: [id])
  context            String   @default("personal")
  chain              String   @default("stacks:mainnet")
  slippageBps        Int      @default(100)
  maxPositionPct     Float    @default(25.0)
  dailyLossLimit     Float    @default(5.0)
  rebalanceThreshold Float    @default(2.0)
  useGasless         Boolean  @default(false)
  gaslessFeeToken    String   @default("USDC")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Trade {
  id           Int       @id @default(autoincrement())
  walletId     Int
  wallet       Wallet    @relation(fields: [walletId], references: [id])
  userId       Int
  user         User      @relation(fields: [userId], references: [id])
  direction    String
  tokenIn      String
  tokenOut     String
  amountIn     Float
  amountOut    Float
  feeAmount    Float     @default(0)
  feeBps       Int       @default(30)
  txId         String?
  status       String    @default("PENDING")
  errorMessage String?
  isGasless        Boolean   @default(false)
  relayerFeeAmount Float?
  relayerFeeToken  String?
  amountInUsd      Float?
  amountOutUsd     Float?
  createdAt    DateTime  @default(now())
  confirmedAt  DateTime?

  @@index([userId, status, createdAt])
}

model MarketMakingGrid {
  id         Int      @id @default(autoincrement())
  userId     Int
  walletId   Int
  tokenPair  String
  midPrice   Float
  gridLevels Int      @default(5)
  spreadBps  Int
  lastUpdated DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@unique([walletId, tokenPair])
}

model AIRecommendation {
  id               Int      @id @default(autoincrement())
  userId           Int
  context          String
  inputHash        String
  modelProvider    String
  modelName        String
  promptTokens     Int
  completionTokens Int
  recommendation   Json
  actedUpon        Boolean  @default(false)
  createdAt        DateTime @default(now())
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model EmailToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  type      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, type])
  @@index([token])
}

model LimitOrder {
  id          Int       @id @default(autoincrement())
  userId      Int
  walletId    Int
  tokenIn     String
  tokenOut    String
  direction   String
  targetPrice Float
  amountIn    Float
  status      String    @default("ACTIVE")
  forceAfter  DateTime?
  expiresAt   DateTime?
  failureCount Int       @default(0)
  createdAt   DateTime  @default(now())
  filledAt    DateTime?
  txId        String?

  @@index([userId, walletId])
  @@index([status])
}

model BlockedToken {
  id         Int      @id @default(autoincrement())
  userId     Int
  contractId String
  symbol     String
  createdAt  DateTime @default(now())

  @@unique([userId, contractId])
  @@index([userId])
}

model TradingStrategy {
  id        Int      @id @default(autoincrement())
  userId    Int
  agentId   Int?
  type      String
  config    Json
  state     Json     @default("{}")
  isActive  Boolean  @default(true)
  failureCount Int    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([agentId])
}

model TradeAgent {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  context   String    @default("custom")
  aiMode    String    @default("off")
  config    Json
  state     Json      @default("{}")
  model     String    @default("deepseek-v4-pro")
  isActive  Boolean   @default(true)
  failureCount Int     @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model PerpPosition {
  id               Int      @id @default(autoincrement())
  userId           Int
  user             User     @relation(fields: [userId], references: [id])
  walletId         Int
  wallet           Wallet   @relation(fields: [walletId], references: [id])
  market           String   
  direction        String   // "LONG" | "SHORT"
  size             Float    
  leverage         Float    
  entryPrice       Float
  liquidationPrice Float
  margin           Float    
  status           String   // "OPEN" | "CLOSED" | "LIQUIDATED"
  txId             String?  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([walletId])
  @@index([status])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String
  details   String
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  type      String   // "INFO" | "WARNING" | "ERROR" | "SUCCESS"
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model Candle {
  id        Int      @id @default(autoincrement())
  // Network the token lives on. Without it the unique key collides across
  // chains: "USDC" on Base and "USDC" on Stacks are different assets at
  // different prices, and one would silently overwrite the other's candles.
  chainId   String   @default("stacks:mainnet")
  token     String
  timeframe String   // "1m", "5m", "15m", "1h", "4h", "1d"
  timestamp DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float    @default(0)

  @@unique([chainId, token, timeframe, timestamp])
  @@index([chainId, token, timeframe, timestamp])
}

// Cross-chain token catalogue backing the public discovery pages. Synced from
// the registered DEX providers rather than a third-party market-data feed, so
// prices are DEX-derived by construction — see isVerified / liquidityUsd for
// the quality signals that gate what gets listed.
model Token {
  id             Int       @id @default(autoincrement())
  chainId        String
  contractId     String    // address, principal, or mint depending on the chain
  symbol         String
  name           String
  decimals       Int
  logoUrl        String?
  priceUsd       Float?
  priceChange24h Float?
  volume24h      Float?
  liquidityUsd   Float?
  marketCapUsd   Float?
  isVerified     Boolean   @default(false)
  lastSyncedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([chainId, contractId])
  @@index([chainId, volume24h])
  @@index([symbol])
}

model PoolStatsHistory {
  id                  Int      @id @default(autoincrement())
  token               String
  timestamp           DateTime @default(now())
  liquidityUsd        Float
  tvlUsd              Float
  volume24hUsd        Float
  holderConcentration Float    @default(0)
  netWhaleFlowUsd     Float    @default(0)

  @@index([token, timestamp])
}

// A linked social identity that may act on a user's behalf.
//
// Keyed on platformUserId, never the handle: handles are transferable and
// re-registrable, so trusting one would let anyone who acquires an abandoned
// @name move another user's funds.
model SocialAccount {
  id             Int       @id @default(autoincrement())
  userId         Int
  user           User      @relation(fields: [userId], references: [id])
  platform       String    // "x" | "farcaster"
  platformUserId String    // immutable numeric/fid identifier
  handle         String    // display only — never used for authorization
  verifiedAt     DateTime?
  // Caps enforced before execution and independently of RiskManager, so a
  // compromised social account cannot drain an account even if it passes
  // every trading-risk check.
  perTradeLimitUsd Float   @default(50)
  dailyLimitUsd    Float   @default(200)
  // Confirm-first by default: a reply with a signed link the user must open.
  // Auto-execute is strictly opt-in.
  autoExecute    Boolean   @default(false)
  enabled        Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  commands SocialCommand[]

  @@unique([platform, platformUserId])
  @@index([userId])
}

// One row per inbound post that addressed the bot.
//
// The unique key on [platform, postId] is the idempotency guard: streams
// redeliver, webhooks retry, and a restart can replay a backlog. Without it
// the same tweet could execute a trade more than once.
model SocialCommand {
  id              Int       @id @default(autoincrement())
  socialAccountId Int?
  socialAccount   SocialAccount? @relation(fields: [socialAccountId], references: [id])
  platform        String
  postId          String
  authorId        String
  rawText         String
  parsedIntent    String?   // JSON of the validated intent, or null if unparseable
  status          String    @default("RECEIVED") // RECEIVED|REJECTED|AWAITING_CONFIRMATION|EXECUTED|FAILED
  rejectionReason String?
  tradeId         Int?
  confirmToken    String?   @unique
  confirmExpiresAt DateTime?
  createdAt       DateTime  @default(now())

  @@unique([platform, postId])
  @@index([socialAccountId, createdAt])
}
