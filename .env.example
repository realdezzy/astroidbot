# Database
ASTROIDBOT_DATABASE_URL="postgresql://user:pass@localhost:5432/astroidbot"

# Encryption key for wallet private keys (32 bytes, base64-encoded)
# Generate with: python3 -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
AES_KEY="your-generated-base64-key-here"

# AI Provider configuration
AI_PROVIDER="deepseek"
AI_MODEL="deepseek-v4-pro"
# OPENAI_API_KEY="sk-..."
# GOOGLE_AI_API_KEY="..."
DEEPSEEK_API_KEY="sk-..."

# Stacks network
STACKS_NETWORK="mainnet"
STACKS_API_URL="https://api.hiro.so"

# Bot configuration
POLL_INTERVAL_SECONDS=60
DRY_RUN=true
LOG_LEVEL="info"

# Token filtering (comma-separated contract IDs; empty = all tokens)
ALLOWED_TOKENS=""
BLOCKED_TOKENS=""
DUST_THRESHOLD_USD=0.50

# Telegram (required for auth + bot commands)
# TELEGRAM_WEBHOOK_URL: ngrok or production URL. If set, bot uses webhooks instead of polling.
# TELEGRAM_ADMIN_IDS: comma-separated Telegram user IDs with admin access
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrsTUVwxyz"
TELEGRAM_WEBHOOK_URL=""
TELEGRAM_ADMIN_IDS="123456789"

# Email (SMTP) for verification and password reset
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="astroidbot@example.com"
SMTP_PASS=""
SMTP_FROM="AstroidBot <astroidbot@example.com>"
BCRYPT_ROUNDS=12

# API Server
PORT=8006
JWT_SECRET="generate-a-random-string-at-least-32-characters-and-replace-this"
JWT_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY_DAYS=30
CORS_ORIGIN="http://localhost:5173"
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# VelumX Relayer for gasless swaps
# VELUMX_RELAYER_URL: full API base including /api/v1 path — NOT a frontend proxy path
VELUMX_RELAYER_URL="https://api.velumx.xyz/api/v1"
VELUMX_API_KEY="vx-..."

# RPC redundancy
STACKS_FALLBACK_API_URLS="https://stacks-node-api.mainnet.stacks.co"

# KMS Configuration
KMS_PROVIDER="local"
KMS_KEY_ID=""

# Redis Configuration
REDIS_URL="redis://localhost:6379"

# ─── Chains ──────────────────────────────────────────────────────────────────
# Comma-separated ChainIds this deployment transacts on.
#
# The default is multichain — one chain per execution family — and every chain
# in it runs with no credentials beyond a database and Redis. Leave this unset
# unless you want a different set.
#
# An unknown ChainId here is a startup failure, never a silent skip. A chain
# that prefers ERC-4337 but has no PIMLICO_API_KEY is the one exception: it
# runs as a plain EOA and says so. See Docs/chains.md.
# ENABLED_CHAINS="stacks:mainnet,base:mainnet,robinhood:mainnet,solana:mainnet"
# Everything this build can describe:
#   stacks:mainnet  stacks:testnet
#   ethereum:mainnet  base:mainnet  base:sepolia  celo:mainnet
#   robinhood:mainnet          (Arbitrum Orbit L2, chain 4663, Uniswap V3)
#   arc:testnet                (Circle's Arc — testnet only, not tradable yet)
#   solana:mainnet  solana:devnet
# ENABLED_CHAINS="stacks:mainnet,ethereum:mainnet,base:mainnet,celo:mainnet,robinhood:mainnet,solana:mainnet"

# Per-chain RPC overrides. The name is derived from the ChainId — base:mainnet
# becomes RPC_URL_BASE_MAINNET. Unset means the descriptor's public default,
# which rate-limits hard; the indexer is by far the heaviest RPC consumer here.
# Validated at startup, and the resolved host per chain is logged by
# "[chains] Enabled" so you can see what each one is actually talking to.
#
# RPC_URL_ETHEREUM_MAINNET="https://eth-mainnet.g.alchemy.com/v2/..."
# RPC_URL_BASE_MAINNET="https://base-mainnet.g.alchemy.com/v2/..."
# RPC_URL_CELO_MAINNET="https://celo-mainnet.g.alchemy.com/v2/..."
# RPC_URL_ROBINHOOD_MAINNET="https://robinhood-mainnet.g.alchemy.com/v2/..."
# RPC_URL_SOLANA_MAINNET="https://solana-mainnet.g.alchemy.com/v2/..."
#
# Alchemy serves every chain above. It does NOT serve Stacks, which keeps
# api.hiro.so (set HIRO_API_KEY for headroom there instead).
#
# Alchemy's Free tier caps eth_getLogs at a 10-BLOCK RANGE, which this indexer
# cannot work with — Base alone produces a block every ~2s and Robinhood every
# ~100ms. The log reader detects the cap, narrows its chunks and warns rather
# than stalling, but the only real fix is Pay As You Go. Migrate one chain at a
# time and watch the "[indexer] ingested" lines.
#
# Polling, not streaming, is the intended transport. Alchemy bills WebSocket
# subscriptions by bytes delivered (0.04 CU/byte), and for a product whose
# finest resolution is a 5-minute candle that costs roughly 120x more than
# eth_getLogs for the same data — on Robinhood, block headers alone would cost
# more than reading every swap. If you add a subscription, add it as a trigger
# that enqueues work, never as something that advances a cursor.

# Pimlico bundler + paymaster, for ERC-4337 wallets (Safe smart accounts).
# Get a key at https://dashboard.pimlico.io.
# Optional. Chains that prefer ERC-4337 (Base) run as plain EOAs without it —
# they still trade; users just pay their own gas. Set it to enable sponsorship
# and atomic batching. Chains configured with "eoa" custody (Celo) ignore it.
# PIMLICO_API_KEY="pim_..."

# Legacy Base selector, still honoured when base:* is enabled without an
# explicit ChainId.
BASE_NETWORK="sepolia"
# BASE_RPC_URL="https://base-sepolia.g.alchemy.com/v2/..."

# EVM networks not in the built-in catalogue — the supported path for chains
# whose router deployments we can't pin (ARC, Robinhood Chain). No code change
# required. Omit "dex" and the chain is listable but not tradable.
# CUSTOM_EVM_CHAINS='[{"chainId":"arc:mainnet","displayName":"ARC","id":4242,"rpcUrl":"https://rpc.arc.example","nativeSymbol":"ARC","stableSymbol":"USDC"}]'

# ─── Social trading ──────────────────────────────────────────────────────────
# Lets a linked X/Farcaster account trade by tagging the bot. OFF by default:
# this surface lets a public post move real funds. Read Docs/social-trading.md
# before enabling. Accepts true/false/1/0.
SOCIAL_TRADING_ENABLED="false"
SOCIAL_BOT_HANDLES="astroidbot"
# X_BEARER_TOKEN="..."
# NEYNAR_API_KEY="..."

# Jupiter (Solana routing). Without a key the free lite-api host is used, which
# rate-limits per IP — fine for one deployment, not for one quoting for many
# users. A key switches to api.jup.ag; nothing else changes.
# JUPITER_API_KEY="..."
# FARCASTER_BOT_FID="123456"
# NEYNAR_SIGNER_UUID="..."

# ─── Market data & the indexer ───────────────────────────────────────────────
# Where price, volume, liquidity and the change columns come from.
#   internal    — our own swap index. Production default.
#   dexscreener — third-party API. Development only; it puts someone else's
#                 rate limit in our request path.
#   auto        — internal, falling back per chain while an index warms up.
MARKET_DATA_PROVIDER="internal"

# Ingestion runs in the indexer process (src/indexer.ts, its own container) and
# nowhere else — there is no flag for it, because the API process has no
# ingestion code path to enable. To run without market data, don't start the
# indexer container and set MARKET_DATA_PROVIDER above accordingly.

# Indexer process only. Interval defaults to POLL_INTERVAL_SECONDS.
# INDEXER_POLL_INTERVAL_SECONDS="60"
INDEXER_PORT="8007"

# Tuning. Defaults are sane; the ones worth knowing are the first two.
# Reorg safety. These are a FLOOR in blocks plus a target in wall-clock
# seconds; a chain that states its block time gets whichever is larger, so the
# guarantee is the same everywhere instead of an accident of block rate.
# Twelve blocks is 2.4 minutes on Ethereum and was 1.2 SECONDS on Robinhood,
# which is what motivated the split. Resolved values are logged at startup by
# "[indexer] chain-specific safety margins".
#   ethereum 12s/block ->  12 blocks (2.4m, unchanged — floor already exceeds)
#   base      2s/block ->  30 blocks (60s)
#   celo      1s/block ->  60 blocks (60s)
#   robinhood 0.1s     -> 595 blocks (60s)
# INDEXER_CONFIRMATIONS="12"             # floor, in blocks
# INDEXER_CONFIRMATION_SECONDS="60"      # the target that actually matters
# INDEXER_MAX_POOLS_PER_CHAIN="300"      # tracked pools, most-recently-active first
# INDEXER_MAX_TX_PER_RUN="300"           # per-tick cap on Stacks/Solana, where cost scales with swaps
# INDEXER_BLOCK_CHUNK_SIZE="2000"
# INDEXER_MAX_BLOCKS_PER_RUN="20000"
# Same floor-plus-target shape for the first run's lookback. The downward
# backfill walk fills in the rest, so this only has to bootstrap.
# INDEXER_INITIAL_LOOKBACK_BLOCKS="50000"   # floor, in blocks
# INDEXER_INITIAL_LOOKBACK_HOURS="6"        # history a first pass should reach
# INDEXER_MAX_ADDRESSES_PER_FILTER="100"
# INDEXER_MAX_SPLIT_DEPTH="12"
# INDEXER_RETRY_BACKOFF_MS="1000"
# INDEXER_MIN_POOL_LIQUIDITY_USD="1000"
# INDEXER_CANDLE_RETENTION_DAYS="30"
# INDEXER_LOCK_TTL_MS="300000"           # per-chain ingestion lock; must outlast a normal pass

# History. The downward walk fills in the past a freshly-indexed chain started
# above, so its first day of 24H figures isn't a fraction of the real one.
# INDEXER_BACKFILL_WINDOW_HOURS="24"           # history to cover; 0 disables the walk
# INDEXER_MAX_BACKFILL_BLOCKS_PER_RUN="10000"  # per-tick budget, kept below the forward pass's
# INDEXER_MAX_BACKFILL_SOURCES_PER_RUN="10"    # contracts (Stacks) or pools (Solana) per tick
# Walk to genesis rather than the window. Off by default: the columns stop at
# 24H, so this buys chart depth at a cost measured in RPC calls, and on a chain
# millions of blocks deep it is days of walking. Overrides the window above.
# INDEXER_BACKFILL_FULL_HISTORY="false"

# The indexer is by far the heaviest RPC consumer in the process. Point each
# indexed chain at a paid endpoint via the per-chain override above —
# Ethereum mainnet in particular is not practical through a public one.
