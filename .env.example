# Database
ASTROIDBOT_DATABASE_URL="postgresql://user:pass@localhost:5432/astroidbot"

# Encryption key for wallet private keys (32 bytes, base64-encoded)
# Generate with: python3 -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
AES_KEY="your-generated-base64-key-here"

# AI Provider configuration
AI_PROVIDER="deepseek"
AI_MODEL="deepseek-v4-pro"
# OPENAI_API_KEY="sk-..."
# GOOGLE_AI_API_KEY="..."
DEEPSEEK_API_KEY="sk-..."

# Stacks network
STACKS_NETWORK="mainnet"
STACKS_API_URL="https://api.hiro.so"

# Bot configuration
POLL_INTERVAL_SECONDS=60
DRY_RUN=true
LOG_LEVEL="info"

# Token filtering (comma-separated contract IDs; empty = all tokens)
ALLOWED_TOKENS=""
BLOCKED_TOKENS=""
DUST_THRESHOLD_USD=0.50

# Telegram (required for auth + bot commands)
# TELEGRAM_WEBHOOK_URL: ngrok or production URL. If set, bot uses webhooks instead of polling.
# TELEGRAM_ADMIN_IDS: comma-separated Telegram user IDs with admin access
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrsTUVwxyz"
TELEGRAM_WEBHOOK_URL=""
TELEGRAM_ADMIN_IDS="123456789"

# Email (SMTP) for verification and password reset
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="astroidbot@example.com"
SMTP_PASS=""
SMTP_FROM="AstroidBot <astroidbot@example.com>"
BCRYPT_ROUNDS=12

# API Server
PORT=8006
JWT_SECRET="generate-a-random-string-at-least-32-characters-and-replace-this"
JWT_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY_DAYS=30
CORS_ORIGIN="http://localhost:5173"
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# VelumX Relayer for gasless swaps
# VELUMX_RELAYER_URL: full API base including /api/v1 path — NOT a frontend proxy path
VELUMX_RELAYER_URL="https://api.velumx.xyz/api/v1"
VELUMX_API_KEY="vx-..."

# RPC redundancy
STACKS_FALLBACK_API_URLS="https://stacks-node-api.mainnet.stacks.co"

# KMS Configuration
KMS_PROVIDER="local"
KMS_KEY_ID=""

# Redis Configuration
REDIS_URL="redis://localhost:6379"

# ─── Chains ──────────────────────────────────────────────────────────────────
# Comma-separated ChainIds this deployment transacts on. The default is
# Stacks-only, identical to pre-multichain behaviour. A chain named here that
# isn't in the catalogue, or that lacks its credentials, is a startup failure —
# never a silent skip. See Docs/chains.md.
ENABLED_CHAINS="stacks:mainnet"
# Everything this build can describe:
#   stacks:mainnet  stacks:testnet
#   ethereum:mainnet  base:mainnet  base:sepolia  celo:mainnet
#   robinhood:mainnet          (Arbitrum Orbit L2, chain 4663, Uniswap V3)
#   arc:testnet                (Circle's Arc — testnet only, not tradable yet)
#   solana:mainnet  solana:devnet
# ENABLED_CHAINS="stacks:mainnet,ethereum:mainnet,base:mainnet,celo:mainnet,robinhood:mainnet,solana:mainnet"

# Per-chain RPC overrides. The name is derived from the ChainId:
# RPC_URL_BASE_MAINNET="https://base-mainnet.g.alchemy.com/v2/..."
# RPC_URL_SOLANA_MAINNET="https://your-solana-rpc.example"

# Required only for chains using ERC-4337 custody (Base). Those wallets are
# Safe smart accounts sponsored via Pimlico's bundler + paymaster —
# get a key at https://dashboard.pimlico.io. Chains configured with "eoa"
# custody (e.g. Celo) need nothing here.
# PIMLICO_API_KEY="pim_..."

# Legacy Base selector, still honoured when base:* is enabled without an
# explicit ChainId.
BASE_NETWORK="sepolia"
# BASE_RPC_URL="https://base-sepolia.g.alchemy.com/v2/..."

# EVM networks not in the built-in catalogue — the supported path for chains
# whose router deployments we can't pin (ARC, Robinhood Chain). No code change
# required. Omit "dex" and the chain is listable but not tradable.
# CUSTOM_EVM_CHAINS='[{"chainId":"arc:mainnet","displayName":"ARC","id":4242,"rpcUrl":"https://rpc.arc.example","nativeSymbol":"ARC","stableSymbol":"USDC"}]'

# ─── Social trading ──────────────────────────────────────────────────────────
# Lets a linked X/Farcaster account trade by tagging the bot. OFF by default:
# this surface lets a public post move real funds. Read Docs/social-trading.md
# before enabling. Accepts true/false/1/0.
SOCIAL_TRADING_ENABLED="false"
SOCIAL_BOT_HANDLES="astroidbot"
# X_BEARER_TOKEN="..."
# NEYNAR_API_KEY="..."
